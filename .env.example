# Private key of the deploying account (Ganache account for local, MetaMask test account for Sepolia).
# Never use a key that holds real funds.
PRIVATE_KEY=0x...

# Ganache CLI = http://127.0.0.1:8545, Ganache desktop app = http://127.0.0.1:7545
GANACHE_URL=http://127.0.0.1:8545

# Sepolia RPC from Alchemy/Infura (optional, a public RPC is used if empty)
SEPOLIA_RPC_URL=

# Etherscan API key (optional, only for verifying the contract source)
ETHERSCAN_API_KEY=

# Pinata JWT (API Keys page on app.pinata.cloud), for pinning to remote IPFS
PINATA_JWT=

# Filled in after pinning: ipfs://<metadata CID>
TOKEN_URI=

# Wallet that receives the badge (defaults to the deployer)
RECIPIENT_ADDRESS=

# Ganache account private key (deterministic account 0 from `npm run ganache`)
GANACHE_PRIVATE_KEY=
